{
  "manifest_version": 3,
  "name": "cerpspy: SERP SEO & Keyword Intelligence",
  "short_name": "cerpspy",
  "version": "3.1.0",
  "description": "Check live Ahrefs DR, domain age, weak spots, SERP CSV export, PAA harvester, and keyword search volume directly on Google.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "cerpspy Domain Intelligence"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
